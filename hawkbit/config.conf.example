# Device-side rauc-hawkbit-updater configuration template.
#
# Installed by the rauc-hawkbit-updater recipe (meta-rauc) at
# /etc/rauc-hawkbit-updater/config.conf, templated at build time from the
# FUS_UPDATE_HAWKBIT_* variables — this file documents the raw device-side
# format those variables produce. Fill in the server IP and the auth_token
# printed by "./hawkbit.sh target <controllerId>".
#
# The daemon polls the hawkBit DDI API, downloads the assigned .raucb to
# bundle_download_location, and installs it: "rauc install" over D-Bus by
# default, or "fs-updater --install_update" when the image's install door
# is fsupdater (FUS_UPDATE_APP_MODE=container, or any image that opts
# FUS_UPDATE_INSTALL_DOOR into fsupdater).

[client]
# Host running the hawkbit compose, reachable from the board. Use the host's
# LAN IP (NOT 127.0.0.1 — that is the device itself). Port 8080 = DDI API.
hawkbit_server            = 192.168.0.10:8080
ssl                       = false
ssl_verify                = false
tenant_id                 = DEFAULT
target_name               = fsimx8mp-01
# = securityToken of the target (printed by ./hawkbit.sh target fsimx8mp-01)
auth_token                = CHANGEME_TARGET_SECURITY_TOKEN
bundle_download_location  = /tmp/bundle.raucb
retry_wait                = 60
connect_timeout           = 20
timeout                   = 60
log_level                 = message

[device]
# Free-form attributes shown in hawkBit; adjust as you like.
product                   = fsimx8mp
model                     = PicoCoreMX8MPr2
